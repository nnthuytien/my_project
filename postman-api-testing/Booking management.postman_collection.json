      "name": "create new booking and view",
      "item": [
        {
          "name": "create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"dataFirstName\", \"Alex\");\r",
                  "pm.collectionVariables.set(\"dataLastName\", \"Brown\");\r",
                  "pm.collectionVariables.set(\"dataPrice\", \"3232\");\r",
                  "pm.collectionVariables.set(\"dataDepositpaid\", true);\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "//Actual result\r",
                  "const getResponse = pm.response.json()\r",
                  "const firsrName_actual =getResponse.booking.firstname\r",
                  "const lastName_actual =getResponse.booking.lastname\r",
                  "const price_actual =getResponse.booking.totalprice\r",
                  "const status_actual =getResponse.booking.depositpaid\r",
                  "\r",
                  "//Expected result\r",
                  "const firstName_expected = pm.variables.get(\"dataFirstName\")\r",
                  "const lastName_expected = pm.variables.get(\"dataLastName\")\r",
                  "const price_expected = pm.variables.get(\"dataPrice\")\r",
                  "const depositpaid_expected = pm.variables.get(\"dataDepositpaid\")\r",
                  "\r",
                  "//Compare\r",
                  "pm.test(\"Verify response is correct\", function () {\r",
                  "    pm.expect(firsrName_actual).to.eql(firstName_expected)\r",
                  "    pm.expect(lastName_actual).to.eql(lastName_expected)\r",
                  "    pm.expect(price_actual.toString()).to.eql(price_expected)\r",
                  "    pm.expect(status_actual).to.eql(depositpaid_expected)\r",
                  "});\r",
                  "\r",
                  "//set booking variables\r",
                  "const booking = getResponse.bookingid \r",
                  "pm.collectionVariables.set(\"bookingID\", booking)\r",
                  "console.log(booking)"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
